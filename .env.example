ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_PRIMARY=gpt-5.4-mini
LLM_FALLBACK=gpt-5.4-mini
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=disclosure-early-warning
DART_API_KEY=
JWT_SECRET=change-me
# Docker 시연은 아래 DB/체크포인트 값을 전용 PostgreSQL로 자동 대체한다.
# SQLite 값은 개발·단위 테스트 참고용이다.
DB_URL=sqlite:///data/app.db
CHECKPOINT_DB=data/checkpoints.db
CHROMA_DIR=data/chroma
BUSINESS_MCP_URL=http://localhost:8001/mcp
RAG_MCP_URL=http://localhost:8002/mcp
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
QUEUE_ENABLED=false
RAG_INDEX_MODE=ephemeral             # 공시별 DART 임시 색인. persistent는 명시적인 과거 평가용
GRAPH_ADAPTER=real                  # Docker 시연은 실제 hosted 연결로 고정

# 운영 PostgreSQL (먼저 uv run alembic upgrade head). SQLite는 로컬 테스트용.
# DB_URL=postgresql+psycopg://dartch:dartch@localhost:5432/dartch
# CHECKPOINT_DB=postgresql://dartch:dartch@localhost:5432/dartch
MCP_HOST=127.0.0.1

# 수집 작업자는 이 시간 안에 heartbeat_run으로 실행 임대를 갱신해야 함
COLLECTION_LEASE_SECONDS=600

# R3 실제 사용 설정 (일일 호출 한도 확정값이 아님)
COLLECT_TIME=09:05
COLLECT_BACKFILL_MONTHS=12
DART_TIMEOUT_SECONDS=30
DART_RETRY_MAX=3
DART_MAX_RPS=4
DART_MAX_CONCURRENCY=3
ANALYSIS_LEASE_SECONDS=120
ANALYSIS_RETRY_DELAY_SECONDS=30
# R3 수동 수집 dispatcher 연결 (기본 false)
COLLECT_DISPATCH_ENABLED=true
# 실제 서비스는 공개 분석·조직별 검토를 분리하는 hosted runtime 사용
PHASE1_RUNTIME_FACTORY=agent.hosted:build_runtime
