ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_PRIMARY=claude-haiku-5-5
LLM_FALLBACK=gpt-5.4-mini
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=disclosure-early-warning
DART_API_KEY=
JWT_SECRET=change-me
DB_URL=sqlite:///data/app.db
CHECKPOINT_DB=data/checkpoints.db
CHROMA_DIR=data/chroma
BUSINESS_MCP_URL=http://localhost:8001/mcp
RAG_MCP_URL=http://localhost:8002/mcp
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
QUEUE_ENABLED=false
RAG_INDEX_MODE=persistent            # persistent(데모: rag_docs를 미리 ingest) | ephemeral(운영: 공시마다 임시 색인, 처리 후 색인·본문 삭제)
FAKE_LLM_ERROR=
FAKE_UNSAFE_DRAFT=false             # true: 첫 안내문 초안에 금지 표현을 섞어 가드레일 시연
GRAPH_ADAPTER=fake                  # fake | real (real은 business-mcp·rag-mcp와 OPENAI_API_KEY 필요)
FAKE_GRAPH_DELAY=0.4

# 운영 PostgreSQL (먼저 uv run alembic upgrade head). SQLite는 로컬 테스트용.
# DB_URL=postgresql+psycopg://dartch:dartch@localhost:5432/dartch
# CHECKPOINT_DB=postgresql://dartch:dartch@localhost:5432/dartch
MCP_HOST=127.0.0.1

# 수집 작업자는 이 시간 안에 heartbeat_run으로 실행 임대를 갱신해야 함
COLLECTION_LEASE_SECONDS=600

# R3 실제 사용 설정 (일일 호출 한도 확정값이 아님)
COLLECT_TIME=09:05
COLLECT_BACKFILL_MONTHS=12
DART_TIMEOUT_SECONDS=30
DART_RETRY_MAX=3
DART_MAX_RPS=4
DART_MAX_CONCURRENCY=3
ANALYSIS_LEASE_SECONDS=120
ANALYSIS_RETRY_DELAY_SECONDS=30
# R3 수동 수집 dispatcher 연결 (기본 false)
COLLECT_DISPATCH_ENABLED=false
# R2 factory module:callable. 미설정 시 새 Graph에 암묵적 fallback하지 않음
# R4 hosted 연결: agent.hosted:build_runtime (적용 전 docs/run.md의 알려진 연결 한계 확인)
PHASE1_RUNTIME_FACTORY=
